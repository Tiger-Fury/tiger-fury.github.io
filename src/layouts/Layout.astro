---
import '../styles/global.css';
const { title = 'TigerFury Fixes — Classic Games. Modern Systems.', description = 'PC game compatibility fixes and RetroInput controller enhancements. Find game-specific downloads, release notes and installation guides.' } = Astro.props;
const base = import.meta.env.BASE_URL;
const socials=[
 {name:'YouTube',icon:'youtube',url:'https://www.youtube.com/@tigerfury'},
 {name:'Twitch',icon:'twitch',url:'https://www.twitch.tv/tigerfuryuk'},
 {name:'Discord',icon:'discord',url:'https://discord.gg/HMmDT6sMRd'},
 {name:'TikTok',icon:'tiktok',url:'https://www.tiktok.com/@tigerfuryuk'},
 {name:'Kick',icon:'kick',url:'https://kick.com/tigerfuryuk'},
 {name:'X',icon:'x',url:'https://x.com/TigerFuryUK'},
 {name:'GitHub',icon:'github',url:'https://github.com/Tiger-Fury'}
];
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="description" content={description}/><meta name="theme-color" content="#050b13"/><title>{title}</title><link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml"/></head><body>
<a class="skip" href="#main">Skip to content</a>
<header><div class="shell header-inner"><a class="brand" href={base} aria-label="TigerFury Fixes home"><img class="tiger-logo" src={`${base}images/tigerfury-logo.png`} alt="" width="52" height="52"/><span>TIGERFURY <b>FIXES</b><small>CLASSIC GAMES. MODERN SYSTEMS.</small></span></a><button id="menu-toggle" class="menu-toggle" aria-expanded="false" aria-controls="navigation">Menu ☰</button><nav id="navigation" aria-label="Main navigation"><a href={base}>Home</a><a href={`${base}#game-fixes`}>Game Fixes</a><a href={`${base}#controller-support`}>Controllers</a><a href={`${base}#retroinput`}>Projects</a><a href={`${base}#releases`}>Downloads</a><a href={`${base}#guides`}>Guides</a><a href={`${base}#about`}>About</a></nav></div></header>
<main id="main"><slot/></main>
<footer id="about"><div class="shell"><div class="footer-top"><a class="brand" href={base}><img class="tiger-logo" src={`${base}images/tigerfury-logo.png`} alt="" width="52" height="52"/><span>TIGERFURY <b>FIXES</b><small>KEEPING CLASSIC GAMES ALIVE.</small></span></a><p>Independent fixes. A little more life for the games we love.</p><div class="footer-socials" role="group" aria-label="TigerFury social links">{socials.map(social=><a class="social-icon-link" href={social.url} aria-label={social.name} title={social.name}><span class="social-icon" style={'mask-image:url('+base+'icons/'+social.icon+'.svg)'} aria-hidden="true"></span></a>)}</div></div><div class="footer-bottom"><span>© {new Date().getFullYear()} TigerFury Fixes</span><a href={`${base}credits/`}>Credits &amp; acknowledgements</a><span>Community projects. Game names belong to their respective owners.</span><span>No site analytics. YouTube loads on request.</span></div></div></footer>
<script>const toggle=document.querySelector<HTMLButtonElement>('#menu-toggle');const nav=document.querySelector('#navigation');toggle?.addEventListener('click',()=>{const open=toggle.getAttribute('aria-expanded')!=='true';toggle.setAttribute('aria-expanded',String(open));nav?.classList.toggle('open',open)});nav?.querySelectorAll('a').forEach(a=>a.addEventListener('click',()=>{toggle?.setAttribute('aria-expanded','false');nav.classList.remove('open')}));</script>
</body></html>



