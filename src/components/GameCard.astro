---
import type { games } from '../data/games';
const { game, compact = false } = Astro.props as {game: typeof games[number],compact?:boolean};
const cover = game.slug==='the-suffering'?'the-suffering.jpg':game.slug==='ties-that-bind'?'ties-that-bind.jpg':null;
---
<article class:list={['game-card', { compact }]} data-game data-title={`${game.title} ${game.category}`.toLowerCase()} data-category={game.category}>
<a href={`${import.meta.env.BASE_URL}fixes/${game.slug}/`} class:list={[`art ${game.theme}`, {'has-cover':cover}]} aria-label={`View ${game.title}`}>{cover && <img class="game-cover" src={import.meta.env.BASE_URL+'images/'+cover} alt="" width="256" height="329" loading="lazy"/>}<span class="art-grid" aria-hidden="true"></span><span class="art-title" aria-hidden="true">{game.mark}</span><span class="art-caption">{game.year} / PC</span></a><div class="card-copy"><span class="badge">{game.category}</span><h3><a href={`${import.meta.env.BASE_URL}fixes/${game.slug}/`}>{game.title}</a></h3>{!compact && <p>{game.description}</p>}{compact ? <p class="year">{game.year}</p> : <a class="text-link" href={`${import.meta.env.BASE_URL}fixes/${game.slug}/`}>View details <span aria-hidden="true">→</span></a>}</div></article>
