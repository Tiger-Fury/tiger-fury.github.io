---
import type {modTools} from '../data/mod-tools';
const {tool}=Astro.props as {tool:typeof modTools[number]};
const base=import.meta.env.BASE_URL;
---
<article class="game-card mod-tool-card"><a href={base+'mod-tools/'+tool.slug+'/'} aria-label={'Explore '+tool.title}><img class="mod-tool-image" src={base+tool.image} alt="CSI Cast Tool extraction and repacking interface" width="856" height="629" loading="lazy"/></a><div class="card-copy"><span class="badge">Mod tools · Windows x64</span><h3>{tool.title}</h3><p>{tool.description}</p><a class="text-link" href={base+'mod-tools/'+tool.slug+'/'}>Details &amp; downloads →</a></div></article>
