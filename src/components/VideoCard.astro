---
import thumbnails from '../data/video-thumbnails.json';
const {video}=Astro.props as {video:{id:string;title:string;type?:string}};
const thumbnail=thumbnails[video.id as keyof typeof thumbnails];
---
<article class="video-card"><div class="video-card-stage" data-video-stage><button type="button" class="video-thumb" data-video-id={video.id} data-video-title={video.title} aria-label={`Load video: ${video.title}`}><img src={import.meta.env.BASE_URL+'images/videos/'+(thumbnail?.file??video.id+'.jpg')} alt="" width={thumbnail?.width??480} height={thumbnail?.height??360} loading="lazy"/><span class="video-play" aria-hidden="true">▶</span></button></div><div class="video-card-copy">{video.type && <p class="video-kind">{video.type==='fix'?'Fix showcase':video.type==='controller'?'Controller showcase':'Full gameplay'}</p>}<h3>{video.title}</h3><a class="text-link" href={'https://www.youtube.com/watch?v='+video.id}>Watch on YouTube ↗</a></div></article>
<script>
document.querySelectorAll<HTMLButtonElement>('[data-video-id]').forEach(button=>button.addEventListener('click',()=>{
 const id=button.dataset.videoId;if(!id||! /^[A-Za-z0-9_-]{11}$/.test(id))return;
 const stage=button.closest('[data-video-stage]');if(!stage)return;
 const frame=document.createElement('iframe');frame.src=`https://www.youtube-nocookie.com/embed/${id}?autoplay=0`;
 frame.title=button.dataset.videoTitle??'TigerFury video';frame.allow='encrypted-media; picture-in-picture; fullscreen';frame.allowFullscreen=true;frame.referrerPolicy='strict-origin-when-cross-origin';frame.tabIndex=0;stage.replaceChildren(frame);frame.focus();
}));
</script>
