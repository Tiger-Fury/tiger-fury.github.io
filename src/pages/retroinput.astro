---
import Layout from '../layouts/Layout.astro';
import {games} from '../data/games';
import GameCard from '../components/GameCard.astro';
import VideoShowcase from '../components/VideoShowcase.astro';
---
<Layout title="RetroInput — TigerFury Fixes"><div class="shell detail"><a class="text-link" href={import.meta.env.BASE_URL}>← Home</a><p class="eyebrow mt-10">CLASSIC CONTROLS. MODERN COMPATIBILITY.</p><h1>Retro<span class="blue">Input</span></h1><p class="lead">Modern controller support, made for each game.</p><p class="reading-width">RetroInput shares controller readers, device selection and button artwork across supported games. Each game has its own bindings and hooks in a separate DLL. Available features depend on the game.</p><div class="flex flex-wrap gap-3 mt-6"><a class="button primary" href="https://github.com/Tiger-Fury/RetroInput-Public/releases">Get RetroInput ↗</a><a class="button secondary" href="https://github.com/Tiger-Fury/RetroInput-Public/blob/main/docs/INSTALLATION.md">Installation guide ↗</a></div><section class="detail-section"><h2>Supported games</h2><div class="featured-grid">{games.filter(g=>g.repo==='RetroInput-Public').sort((a,b)=>a.title.localeCompare(b.title, 'en', {sensitivity:'base', numeric:true})).map(game=><GameCard game={game}/>)}</div></section><VideoShowcase/><section class="guides"><div><h2>Know your controller.</h2><p>Xbox/XInput, DualSense, DualShock 4 and other documented readers are supported. Consult the device guide for connection details and limitations. Rumble and motion controls are not implemented.</p></div><div class="guide-links"><a href="https://github.com/Tiger-Fury/RetroInput-Public/blob/main/docs/SUPPORTED_CONTROLLERS.md">Controller compatibility ↗</a><a href="https://github.com/Tiger-Fury/RetroInput-Public/blob/main/docs/GLYPHS.md">Controls and button artwork ↗</a><a href="https://github.com/Tiger-Fury/RetroInput-Public">Public source & credits ↗</a></div></section></div></Layout>

