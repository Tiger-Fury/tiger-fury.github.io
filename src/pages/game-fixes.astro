---
import Layout from '../layouts/Layout.astro';
import GameCollection from '../components/GameCollection.astro';
import {games} from '../data/games';
const items=games.filter(game=>game.category==='Windows compatibility').sort((a,b)=>a.title.localeCompare(b.title,'en',{sensitivity:'base',numeric:true}));
---
<Layout title="Game Fixes — TigerFury Fixes" description="Browse compatibility, rendering and display fixes for classic PC games, with game-specific downloads and installation instructions."><div class="shell detail"><a class="text-link" href={import.meta.env.BASE_URL}>← Home</a><p class="eyebrow mt-10">CLASSIC GAMES. MODERN SYSTEMS.</p><h1>Game <span class="blue">Fixes</span></h1><p class="lead">Get back to the games you love.</p><p class="reading-width">Compatibility, rendering and display improvements for classic PC games. Choose a game for downloads, installation guidance and videos.</p><section class="detail-section" aria-label="All game fixes"><GameCollection items={items}/></section></div></Layout>
