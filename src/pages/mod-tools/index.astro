---
import Layout from '../../layouts/Layout.astro';
import ModToolCard from '../../components/ModToolCard.astro';
import {modTools as unsortedModTools} from '../../data/mod-tools';
const modTools=[...unsortedModTools].sort((a,b)=>a.title.localeCompare(b.title,'en',{sensitivity:'base',numeric:true}));
---
<Layout title="Mod Tools — TigerFury Fixes" description="Tools for exploring, extracting and editing classic game resources."><div class="shell detail"><a class="text-link" href={import.meta.env.BASE_URL}>← Home</a><p class="eyebrow mt-10">EXPLORE. EDIT. REBUILD.</p><h1>Mod <span class="blue">Tools</span></h1><p class="lead">A closer look inside classic games.</p><p class="reading-width">Game-specific utilities for extracting resources and creating modifications. Each tool has its own supported formats and editing limits.</p><section class="detail-section" aria-label="Available mod tools"><div class="featured-grid category-grid">{modTools.map(tool=><ModToolCard tool={tool}/>)}</div></section></div></Layout>
