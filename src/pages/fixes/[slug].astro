---
import Layout from '../../layouts/Layout.astro';
import {games} from '../../data/games';
import snapshot from '../../data/releases.json';
import videos from '../../data/game-videos.json';
import VideoCard from '../../components/VideoCard.astro';
export function getStaticPaths(){return games.map(game=>({params:{slug:game.slug},props:{game}}));}
const {game}=Astro.props;
const cover=game.slug==='the-suffering'?'the-suffering.jpg':game.slug==='ties-that-bind'?'ties-that-bind.jpg':null;
const release=snapshot.gameReleases[game.slug as keyof typeof snapshot.gameReleases];
function describeAsset(name:string){
 const normalized=name.toLowerCase();
 if(game.slug==='ghost-recon-wildlands'&&normalized.endsWith('.zip'))return {label:'Wildlands Startup Fix',description:'Standalone Windows launcher, optional shortcut installer, source and instructions. Extract before running.'};
 if(normalized.includes('migration'))return {label:'Save migration tool',description:'Optional: import existing saves with backups. Not needed for a new installation.'};
 if(normalized.includes('original')&&game.slug==='csi-3-dimensions-of-murder')return {label:'Original presentation',description:'Standalone launcher retaining the original game presentation.'};
 if(normalized.includes('original'))return {label:'Original 800 × 600',description:'Keep the original resolution and presentation, with compatibility fixes.'};
 if(normalized.includes('fit'))return {label:'Desktop Fit',description:'Scale to your desktop while preserving 4:3 proportions. Borders may appear.'};
 if(normalized.includes('fill'))return {label:'Desktop Fill',description:'Stretch the complete picture to your desktop. No cropping; proportions change.'};
 if(normalized.endsWith('.dll'))return {label:'Controller DLL update',description:'For an existing RetroInput installation. Keep your loader and configuration; read the release notes.'};
 if(normalized.endsWith('.zip'))return {label:'RetroInput package',description:'Controller-support package for this game. Follow the included installation instructions.'};
 return {label:name,description:'Additional release file. See the release notes for details.'};
}
const issueUrl='https://github.com/Tiger-Fury/'+game.repo+'/issues';
---
<Layout title={`${game.title} — TigerFury Fixes`} description={game.description}><div class="shell detail"><a class="text-link" href={import.meta.env.BASE_URL+(game.category==='Controller support'?'retroinput/':'game-fixes/')}>← {game.category==='Controller support'?'Controller support':'Game fixes'}</a><div class="detail-grid"><div class:list={[`art detail-art ${game.theme}`, {'has-cover':cover}]} aria-hidden="true">{cover && <img class="game-cover" src={import.meta.env.BASE_URL+'images/'+cover} alt="" width="256" height="329"/>}<span class="art-grid"></span><span class="art-title">{game.mark}</span></div><div><p class="eyebrow">{game.year} · {game.category}</p><h1>{game.title}</h1><p class="lead">{game.description}</p><p>{game.details}</p><div class="flex flex-wrap gap-3 mt-6"><a class="button primary" href={release.url}>Downloads & release notes ↗</a><a class="button secondary" href={game.source}>Project documentation ↗</a></div><p class="section-note">Public release {release.tag}. Verified {snapshot.checkedAt}. Read the package instructions and back up replaced files.</p></div></div><section class="detail-section"><h2>{game.slug==='ghost-recon-wildlands'?'Download the startup fix':'Choose the right package'}</h2><p>{game.slug==='ghost-recon-wildlands'?'Requires 64-bit Windows 11, .NET Framework 4.x and Ubisoft Connect signed in with access to Wildlands. Extract to a permanent writable folder before running.':game.repo==='RetroInput-Public'?'These downloads are selected for this game from stable RetroInput releases. Each game uses a separate DLL. For a standalone DLL update, keep your existing loader and configuration and follow the linked release notes.':game.slug==='csi-3-dimensions-of-murder'?'Choose Original, Desktop Fit or Desktop Fill. Copy the added launcher EXE beside CSI3.exe and t3.mll, then run it directly. All three can coexist. Keep all original game files.':game.slug==='csi-miami'?'Choose Original 800 × 600, Desktop Fit or Desktop Fill. All three can coexist because their shared files are identical. A full installation is required.':game.slug==='csi-dark-motives'?'Choose one display-mode package: Original, Fit or Fill. The save migration tool is optional for existing saves.':'Choose one package: Original 800 × 600, Desktop Fit or Desktop Fill. Use each executable with its matching scripts.cxt file. The original game is required.'}</p><ul class="download-choices">{release.assets.map(asset=>{const info=describeAsset(asset.name);return <li><div><h3>{info.label}</h3><p>{info.description}</p><small>{asset.name}</small></div><a class="button secondary" href={asset.url} aria-label={'Download '+info.label+' for '+game.title}>Download ↓</a></li>})}</ul></section>{game.slug==='ghost-recon-wildlands' && <section class="detail-section reading-width"><h2>Installation &amp; use</h2><p>Extract the ZIP to a permanent writable folder and close Wildlands. Run Wildlands-Startup-Fix.exe and accept its administrator prompt. The helper starts the game through Ubisoft Connect and handles the temporary startup settings.</p><p>Optionally run Install-Shortcut.cmd to create the Wildlands - Fast Start desktop shortcut. Keep the extracted folder in place. Use this launcher each time you want the workaround.</p><h2>Installation path</h2><p>This release expects GRW.exe at:</p><p class="game-install-path">C:\Program Files (x86)\Ubisoft\Ubisoft Game Launcher\games\Tom Clancy's Ghost Recon Wildlands\GRW.exe</p><p>For another location, the project requires changing GamePath in the C# source and rebuilding. Other paths and Steam installations have not been validated; read the documentation before downloading.</p><h2>Startup period &amp; removal</h2><p>After an initial 12-second launcher handoff, the helper applies temporary scheduling for 60 seconds, restores the saved settings and exits. Do not forcibly stop it during that period. If it is forcibly stopped, close Wildlands to reset its process settings before relaunching.</p><p>To stop using the workaround, close the game and helper, then launch the game normally. The extracted folder and shortcut can be removed. The launcher does not edit game files, saves, CPU affinity, BIOS or Windows security settings.</p></section>}{game.slug==='csi-3-dimensions-of-murder' && <section class="detail-section reading-width"><h2>Installation &amp; removal</h2><p>Close the game, extract the chosen ZIP and copy its EXE into the installation beside CSI3.exe, t3.mll and the original game data. Start the added launcher directly, or update your shortcut to use it.</p><p>No DLL replacement, dgVoodoo installation or external scaler is required. Display changes apply in memory for the launcher session. Keep the original executable, engine and game data.</p><p>To remove the fix, delete the added launcher EXEs and return to the original launch method. The original disc requirement may then apply. Saves are not moved or migrated.</p><h2>Supported engine</h2><p>Fit and Fill validate the engine instructions they adjust and report an error if they do not match. Other engine revisions are untested; see the project documentation for the inspected t3.mll hash and full validation scope.</p></section>}{game.slug==='csi-miami' && <section class="detail-section reading-width"><h2>Installation &amp; rollback</h2><p>Close the game and back up matching files. Copy the chosen package’s EXE/INI files, Framework and xtras into the installation, merging folders and replacing matching files. Keep the existing game data and Lingo.ini.</p><p>Launch CSI-Miami.exe, CSI-Miami-Fit.exe or CSI-Miami-Fill.exe for your chosen presentation. The Original launcher is unchanged; its fixes are in the shared files.</p><p>Each download includes Rollback-original-shared-files.zip. To undo the shared fixes, close the game, extract that rollback into the installation and use the original launcher. Keep backups of earlier customisations.</p></section>}{game.slug==='csi-dark-motives' && <section class="detail-section"><h2>Mod tools</h2><p>Explore and edit cast resources with the separate CSI Cast Tool.</p><a class="text-link" href={import.meta.env.BASE_URL+'mod-tools/csi-cast-tool/'}>CSI: Dark Motives Cast Tool →</a></section>}<section class="game-support" aria-labelledby="support-heading"><div><h2 id="support-heading">Need a hand?</h2><p>Check existing reports or open an issue with your game version, Windows version and a description of what happened.</p></div><a class="button secondary" href={issueUrl}>Report an issue ↗</a></section>{videos.some(video=>video.games.includes(game.slug)) && <section class="detail-section"><h2>Video showcase</h2><p class="section-note">Fix showcases demonstrate the project; full playthroughs may predate the current release.</p><div class="game-video game-video-grid">{videos.filter(video=>video.games.includes(game.slug)).map(video=><VideoCard video={video}/>)}</div></section>}</div></Layout>


