---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import {games} from '../data/games';
import snapshot from '../data/releases.json';
import {projects} from '../data/projects';
import latestVideos from '../data/latest-videos.json';
import VideoCard from '../components/VideoCard.astro';
const base=import.meta.env.BASE_URL;
const alphabetical=(a: typeof games[number],b: typeof games[number])=>a.title.localeCompare(b.title,'en',{sensitivity:'base',numeric:true});
const gameFixes=games.filter(game=>game.category==='Windows compatibility').sort(alphabetical);
const controllerGames=games.filter(game=>game.category==='Controller support').sort(alphabetical);
---
<Layout>
<section class="hero"><div class="hero-scene" aria-hidden="true"><div class="moon"></div><div class="tower t1"></div><div class="tower t2"></div><div class="fence"></div><span class="scene-number">01 / BACK IN PLAY</span></div><div class="shell hero-content"><p class="eyebrow">RESTORING GREAT GAMES</p><h1>Classic Games.<br/><span>Modern Systems.</span></h1><p class="hero-description">PC game compatibility fixes, controller enhancements, and community projects to keep classic games playable on modern hardware.</p><div class="flex flex-wrap gap-3"><a class="button primary" href="#game-fixes">Browse game fixes <span aria-hidden="true">→</span></a><a class="button secondary" href="#controller-support">Controller support</a></div><p class="hero-note"><span aria-hidden="true">●</span> Built for the games worth coming back to.</p></div></section>
<div class="shell content">
<section id="game-fixes" aria-labelledby="fixes-heading"><div class="section-heading"><h2 id="fixes-heading"><span aria-hidden="true">✛</span> Game fixes</h2><a href="#catalogue" data-browse-filter="Windows compatibility">Browse game fixes →</a></div><p class="section-intro">Compatibility, rendering and display improvements for classic PC games.</p><div class="featured-grid category-grid">{gameFixes.map(game=><GameCard game={game}/>)}</div></section>
<section id="controller-support" aria-labelledby="controller-heading"><div class="section-heading"><h2 id="controller-heading"><span aria-hidden="true">✚</span> Controller support</h2><a href={base+'retroinput/'}>Explore RetroInput →</a></div><p class="section-intro">Native controller input and console-style button prompts, tailored to each game.</p><div class="featured-grid category-grid">{controllerGames.map(game=><GameCard game={game}/>)}</div><p class="art-note">Original game cover art and screenshots. Game imagery belongs to its respective owners.</p></section>
<section id="retroinput" aria-labelledby="retro-heading"><div class="section-heading"><h2 id="retro-heading"><span aria-hidden="true">▱</span> Featured project</h2><a href="https://github.com/Tiger-Fury/RetroInput-Public">View on GitHub ↗</a></div><div class="retro-banner"><div><p class="eyebrow">CLASSIC CONTROLS. MODERN COMPATIBILITY.</p><h3>Retro<span>Input</span></h3><p>A controller-support framework for older PC games. Native input, automatic device detection and console-style button images, with a dedicated DLL for each supported game.</p><a class="button primary" href={`${base}retroinput/`}>Discover RetroInput →</a></div><img class="retro-art" src={`${base}images/retroinput.png`} alt="RetroInput — classic games, modern control" width="1920" height="1080" loading="lazy"/><div class="controller" aria-hidden="true"><span class="dpad">✚</span><span class="stick s1"></span><span class="stick s2"></span><span class="controller-buttons">● ●<br/>● ●</span><span class="controller-label">RETROINPUT</span></div><ul class="feature-list"><li>Xbox & PlayStation support</li><li>Automatic button artwork</li><li>Game-specific integration</li><li>Public releases on GitHub</li></ul></div></section>
<section id="releases" aria-labelledby="releases-heading"><div class="section-heading"><h2 id="releases-heading"><span aria-hidden="true">↓</span> Latest releases</h2><span class="muted">Checked {snapshot.checkedAt}</span></div><div class="release-grid">{[...snapshot.releases].sort((a,b)=>b.publishedAt.localeCompare(a.publishedAt)).map(release=><article class="release-card"><div class="release-icon" aria-hidden="true">{projects[release.repo].icon}</div><div><p class="release-version">{release.tag}</p><h3>{projects[release.repo].name}</h3><time datetime={release.publishedAt}>{new Date(release.publishedAt).toLocaleDateString('en-GB',{day:'numeric',month:'short',year:'numeric',timeZone:'UTC'})}</time><p>{release.title}</p><a class="text-link" href={release.url}>Release notes & downloads ↗</a></div></article>)}</div><p class="section-note">Versions and dates come from public GitHub releases. Read the release notes before choosing a package.</p></section>
<section id="catalogue" aria-labelledby="catalogue-heading"><div class="section-heading"><h2 id="catalogue-heading"><span aria-hidden="true">⌕</span> Browse all games</h2><span class="muted">{games.length} games · {new Set(games.map(game=>game.repo)).size} projects</span></div><div class="catalogue-controls"><div class="search-wrap"><label class="sr-only" for="game-search">Search games</label><input id="game-search" type="search" placeholder="Search for a game…" autocomplete="off"/></div><div class="filters" role="group" aria-label="Filter fixes"><button class="filter active" aria-pressed="true" data-filter="All">All</button><button class="filter" aria-pressed="false" data-filter="Controller support">Controller support</button><button class="filter" aria-pressed="false" data-filter="Windows compatibility">Windows compatibility</button></div></div><p id="result-count" class="sr-only" role="status" aria-live="polite">{games.length} games found</p><div id="game-results"><section class="catalogue-group" data-result-group aria-labelledby="catalogue-fixes-heading"><h3 id="catalogue-fixes-heading">Game fixes</h3><div class="catalogue-grid category-grid">{gameFixes.map(game=><GameCard game={game} compact/>)}</div></section><section class="catalogue-group" data-result-group aria-labelledby="catalogue-controllers-heading"><h3 id="catalogue-controllers-heading">Controller support</h3><div class="catalogue-grid category-grid">{controllerGames.map(game=><GameCard game={game} compact/>)}</div></section></div><p id="no-results" hidden>No games match your search. Try another title or select All.</p><noscript><p>All games are shown. Search and filters require JavaScript.</p></noscript></section>
<section id="videos" aria-labelledby="videos-heading"><div class="section-heading"><h2 id="videos-heading"><span aria-hidden="true">▶</span> Latest channel videos</h2><a href="https://www.youtube.com/@tigerfury/videos">All videos on YouTube ↗</a></div><p class="section-intro">Game fixes, playthroughs and classic games from TigerFury. Select a thumbnail to load the YouTube player.</p><div class="video-gallery">{latestVideos.map(video=><VideoCard video={video}/>)}</div></section><section class="channel-showcase" aria-labelledby="channel-heading"><div><p class="eyebrow">WATCH TIGERFURY</p><h2 id="channel-heading">See the fixes in action.</h2><p>Explore videos on the TigerFury YouTube channel, or head to the dedicated RetroInput showcase.</p></div><div class="flex flex-wrap gap-3"><a class="button primary" href="https://www.youtube.com/@tigerfury">TigerFury on YouTube ↗</a><a class="button secondary" href={base+'retroinput/#showcase'}>RetroInput showcase →</a></div></section><section id="guides" class="guides" aria-labelledby="guide-heading"><div><p class="eyebrow">BEFORE YOU PRESS PLAY</p><h2 id="guide-heading">A better start to an old favourite.</h2><p>Choose your game, read its installation instructions, and keep a backup of the files you replace. Downloads stay with their projects on GitHub.</p></div><div class="guide-links"><a href="https://github.com/Tiger-Fury/RetroInput-Public/blob/main/docs/INSTALLATION.md">RetroInput installation <span>↗</span></a><a href="https://github.com/Tiger-Fury/RetroInput-Public/blob/main/docs/SUPPORTED_CONTROLLERS.md">Supported controllers <span>↗</span></a><a href="https://github.com/Tiger-Fury/CSI-Dark-Motives-AiO-Fix#readme">CSI display modes & save migration <span>↗</span></a></div></section>
</div>
<script>
const search=document.querySelector<HTMLInputElement>('#game-search');let category='All';const cards=document.querySelectorAll<HTMLElement>('#game-results [data-game]');const filters=document.querySelectorAll<HTMLButtonElement>('[data-filter]');function update(){const q=search?.value.trim().toLowerCase()??'';let count=0;cards.forEach(card=>{const show=(category==='All'||card.dataset.category===category)&&(card.dataset.title??'').includes(q);card.hidden=!show;if(show)count++});document.querySelectorAll<HTMLElement>('[data-result-group]').forEach(group=>{group.hidden=!Array.from(group.querySelectorAll<HTMLElement>('[data-game]')).some(card=>!card.hidden)});const status=document.querySelector('#result-count');if(status)status.textContent=`${count} ${count===1?'game':'games'} found`;const empty=document.querySelector<HTMLElement>('#no-results');if(empty)empty.hidden=count!==0}search?.addEventListener('input',update);filters.forEach(button=>button.addEventListener('click',()=>{category=button.dataset.filter??'All';filters.forEach(b=>{const active=b===button;b.setAttribute('aria-pressed',String(active));b.classList.toggle('active',active)});update()}));
document.querySelectorAll<HTMLAnchorElement>('[data-browse-filter]').forEach(link=>link.addEventListener('click',()=>{category=link.dataset.browseFilter??'All';filters.forEach(button=>{const active=button.dataset.filter===category;button.setAttribute('aria-pressed',String(active));button.classList.toggle('active',active)});if(search)search.value='';update()}));
</script>
</Layout>



