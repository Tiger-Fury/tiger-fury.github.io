---
import ModToolCard from '../components/ModToolCard.astro';
import {modTools as unsortedModTools} from '../data/mod-tools';
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import {games} from '../data/games';
import snapshot from '../data/releases.json';
import {projects} from '../data/projects';
import latestVideos from '../data/latest-videos.json';
import VideoCard from '../components/VideoCard.astro';
const base=import.meta.env.BASE_URL;
const alphabetical=(a: typeof games[number],b: typeof games[number])=>a.title.localeCompare(b.title,'en',{sensitivity:'base',numeric:true});
const gameFixes=games.filter(game=>game.category==='Windows compatibility').sort(alphabetical);
const controllerGames=games.filter(game=>game.category==='Controller support').sort(alphabetical);
const modTools=[...unsortedModTools].sort((a,b)=>a.title.localeCompare(b.title,'en',{sensitivity:'base',numeric:true}));
---
<Layout>
<section class="hero"><div class="hero-scene" aria-hidden="true"><div class="moon"></div><div class="tower t1"></div><div class="tower t2"></div><div class="fence"></div><span class="scene-number">01 / BACK IN PLAY</span></div><div class="shell hero-content"><p class="eyebrow">RESTORING GREAT GAMES</p><h1>Classic Games.<br/><span>Modern Systems.</span></h1><p class="hero-description">PC game compatibility fixes, controller enhancements, and community projects to keep classic games playable on modern hardware.</p><div class="flex flex-wrap gap-3"><a class="button primary" href={base+'game-fixes/'}>Browse game fixes <span aria-hidden="true">→</span></a><a class="button secondary" href={base+'retroinput/'}>Controller support</a></div><p class="hero-note"><span aria-hidden="true">●</span> Built for the games worth coming back to.</p></div></section>
<div class="shell content">
<section id="game-fixes" aria-labelledby="fixes-heading"><div class="section-heading"><h2 id="fixes-heading"><span aria-hidden="true">✛</span> Game fixes</h2><a href={base+'game-fixes/'}>View all game fixes →</a></div><p class="section-intro">Compatibility, rendering and display improvements for classic PC games.</p><div class="featured-grid category-grid">{gameFixes.slice(0,2).map(game=><GameCard game={game}/>)}</div></section>
<section id="controller-support" aria-labelledby="controller-heading"><div class="section-heading"><h2 id="controller-heading"><span aria-hidden="true">✚</span> Controller support</h2><a href={base+'retroinput/'}>View all controller support →</a></div><p class="section-intro">Native controller input and console-style button prompts, tailored to each game.</p><div class="featured-grid category-grid">{controllerGames.slice(0,2).map(game=><GameCard game={game}/>)}</div><p class="art-note">Original game cover art and screenshots. Game imagery belongs to its respective owners.</p></section>
<section id="mod-tools" aria-labelledby="mod-tools-heading"><div class="section-heading"><h2 id="mod-tools-heading"><span aria-hidden="true">⚒</span> Mod tools</h2><a href={base+'mod-tools/'}>View all mod tools →</a></div><p class="section-intro">Tools for exploring and editing classic game resources.</p><div class="featured-grid category-grid">{modTools.slice(0,2).map(tool=><ModToolCard tool={tool}/>)}</div></section>
<section id="retroinput" aria-labelledby="retro-heading"><div class="section-heading"><h2 id="retro-heading"><span aria-hidden="true">▱</span> Featured project</h2><a href="https://github.com/Tiger-Fury/RetroInput-Public">View on GitHub ↗</a></div><div class="retro-banner"><div><p class="eyebrow">CLASSIC CONTROLS. MODERN COMPATIBILITY.</p><h3>Retro<span>Input</span></h3><p>A controller-support framework for older PC games. Native input, automatic device detection and console-style button images, with a dedicated DLL for each supported game.</p><a class="button primary" href={`${base}retroinput/`}>Discover RetroInput →</a></div><img class="retro-art" src={`${base}images/retroinput.png`} alt="RetroInput — classic games, modern control" width="1920" height="1080" loading="lazy"/><div class="controller" aria-hidden="true"><span class="dpad">✚</span><span class="stick s1"></span><span class="stick s2"></span><span class="controller-buttons">● ●<br/>● ●</span><span class="controller-label">RETROINPUT</span></div><ul class="feature-list"><li>Xbox & PlayStation support</li><li>Automatic button artwork</li><li>Game-specific integration</li><li>Public releases on GitHub</li></ul></div></section>
<section id="releases" aria-labelledby="releases-heading"><div class="section-heading"><h2 id="releases-heading"><span aria-hidden="true">↓</span> Latest releases</h2><span class="muted">Checked {snapshot.checkedAt}</span></div><div class="release-grid">{[...snapshot.releases].sort((a,b)=>b.publishedAt.localeCompare(a.publishedAt)).map(release=><article class="release-card"><div class="release-icon" aria-hidden="true">{projects[release.repo].icon}</div><div><p class="release-version">{release.tag}</p><h3>{projects[release.repo].name}</h3><time datetime={release.publishedAt}>{new Date(release.publishedAt).toLocaleDateString('en-GB',{day:'numeric',month:'short',year:'numeric',timeZone:'UTC'})}</time><p>{release.title}</p><a class="text-link" href={release.url}>Release notes & downloads ↗</a></div></article>)}</div><p class="section-note">Versions and dates come from public GitHub releases. Read the release notes before choosing a package.</p></section>
<section id="catalogue" aria-labelledby="catalogue-heading"><div class="section-heading"><h2 id="catalogue-heading"><span aria-hidden="true">⌕</span> Explore the catalogue</h2></div><p class="section-intro">Browse the complete collections, with games listed A–Z.</p><div class="category-directory"><a href={base+'game-fixes/'}><h3>Game fixes <span aria-hidden="true">→</span></h3><p>Compatibility, rendering and display improvements.</p><span class="muted">{gameFixes.length} games</span></a><a href={base+'retroinput/'}><h3>Controller support <span aria-hidden="true">→</span></h3><p>Game-specific controls and RetroInput integrations.</p><span class="muted">{controllerGames.length} games</span></a><a href={base+'mod-tools/'}><h3>Mod tools <span aria-hidden="true">→</span></h3><p>Utilities for exploring and editing game resources.</p><span class="muted">{modTools.length} {modTools.length===1?'tool':'tools'}</span></a></div></section>
<section id="videos" aria-labelledby="videos-heading"><div class="section-heading"><h2 id="videos-heading"><span aria-hidden="true">▶</span> Latest channel videos</h2><a href="https://www.youtube.com/@tigerfury/videos">All videos on YouTube ↗</a></div><p class="section-intro">Game fixes, playthroughs and classic games from TigerFury. Select a thumbnail to load the YouTube player.</p><div class="video-gallery">{latestVideos.map(video=><VideoCard video={video}/>)}</div></section><section class="channel-showcase" aria-labelledby="channel-heading"><div><p class="eyebrow">WATCH TIGERFURY</p><h2 id="channel-heading">See the fixes in action.</h2><p>Explore videos on the TigerFury YouTube channel, or head to the dedicated RetroInput showcase.</p></div><div class="flex flex-wrap gap-3"><a class="button primary" href="https://www.youtube.com/@tigerfury">TigerFury on YouTube ↗</a><a class="button secondary" href={base+'retroinput/#showcase'}>RetroInput showcase →</a></div></section><section id="guides" class="guides" aria-labelledby="guide-heading"><div><p class="eyebrow">BEFORE YOU PRESS PLAY</p><h2 id="guide-heading">A better start to an old favourite.</h2><p>Choose your game, read its installation instructions, and keep a backup of the files you replace. Downloads stay with their projects on GitHub.</p></div><div class="guide-links"><a href="https://github.com/Tiger-Fury/RetroInput-Public/blob/main/docs/INSTALLATION.md">RetroInput installation <span>↗</span></a><a href="https://github.com/Tiger-Fury/RetroInput-Public/blob/main/docs/SUPPORTED_CONTROLLERS.md">Supported controllers <span>↗</span></a><a href="https://github.com/Tiger-Fury/CSI-Dark-Motives-AiO-Fix#readme">CSI display modes & save migration <span>↗</span></a></div></section>
</div>

</Layout>



